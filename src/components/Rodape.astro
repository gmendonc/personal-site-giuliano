---
import Newsletter from './Newsletter.astro';
import { NAVEGACAO, SITE_SUBTITULO } from '../config';
---

<footer class="rodape">
  <div class="container">
    <div class="rodape-grade">
      <div>
        <p class="rodape-wordmark">Giuliano <em>Mendonça</em></p>
        <p class="rodape-tagline">{SITE_SUBTITULO}</p>
      </div>

      <nav class="rodape-links" aria-label="Rodapé">
        {
          NAVEGACAO.map((item) =>
            item.href ? (
              <a href={item.href}>{item.rotulo}</a>
            ) : (
              <span aria-disabled="true">{item.rotulo}</span>
            ),
          )
        }
      </nav>

      <div class="rodape-links">
        <a href="mailto:ola@giulianomendonca.com">E-mail</a>
        <a href="/rss.xml">RSS</a>
        {/* Sem URL de perfil conhecida, o item fica inerte em vez de apontar
            para lugar nenhum — mesma regra do menu (SPEC §5). */}
        <span aria-disabled="true">LinkedIn</span>
      </div>

      <div>
        <Newsletter variante="rodape" />
      </div>
    </div>

    {/* Declaração técnica corrigida — SPEC §3.3. O número de kB do protótipo
        saiu: media um proxy, não a premissa. O que ficou é integralmente
        verificável, e §7.3.3 verifica. */}
    <p class="rodape-declaracao">
      Declaração técnica — site estático, sem rastreadores, sem cookies e sem pop-up de
      assinatura. Nenhuma requisição a servidor de terceiros: fontes, estilos e scripts saem
      daqui. Nenhuma biblioteca de animação, nenhuma imagem de banco.
    </p>
  </div>
</footer>

<style>
  /* O rodapé é escuro nos dois temas, de propósito — é uma faixa de fecho, não
     uma superfície que acompanha o tema. */
  .rodape {
    margin-top: var(--space-11);
    background: var(--graphite-900);
    border-top: var(--border-width) solid var(--graphite-800);
    padding-block: var(--space-9) var(--space-7);
  }

  .rodape-grade {
    display: grid;
    grid-template-columns: 1.2fr 0.6fr 0.6fr 1.4fr;
    gap: var(--space-7);
    align-items: start;
  }

  .rodape-wordmark {
    font-family: var(--font-display);
    font-weight: var(--fw-medium);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-tight);
    color: var(--ivory-50);
    margin: 0 0 var(--space-2);
  }

  .rodape-wordmark em {
    color: var(--gold-300);
    font-style: italic;
  }

  .rodape-tagline {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    /* --ivory-100 a 78% sobre --graphite-900 mantém contraste AA. */
    color: color-mix(in srgb, var(--ivory-100) 78%, transparent);
    line-height: var(--lh-relaxed);
  }

  .rodape-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .rodape-links a,
  .rodape-links span {
    font-size: var(--text-sm);
    color: color-mix(in srgb, var(--ivory-100) 88%, transparent);
    text-decoration: none;
    /* Alvo de toque no mobile. */
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .rodape-links a:hover {
    color: var(--gold-300);
    text-decoration: underline;
  }

  .rodape-links span[aria-disabled='true'] {
    color: color-mix(in srgb, var(--ivory-100) 62%, transparent);
    cursor: default;
  }

  .rodape-declaracao {
    margin: var(--space-8) 0 0;
    padding-top: var(--space-5);
    border-top: var(--border-width) solid var(--graphite-700);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--lh-relaxed);
    color: color-mix(in srgb, var(--ivory-100) 75%, transparent);
    max-width: 90ch;
  }

  @media (max-width: 860px) {
    .rodape-grade {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
