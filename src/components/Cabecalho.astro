---
import { NAVEGACAO } from '../config';

/**
 * Header sticky com backdrop-filter, como no protótipo.
 *
 * O botão "buscar" do protótipo NÃO entra nesta fatia — foi removido, não
 * deixado inerte, porque um botão que não faz nada é pior que ausência
 * (SPEC §5.4). Os itens de menu ainda não implementados ficam visíveis e
 * inertes: link para 404 é pior que link inerte (SPEC §5).
 */
const caminho = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
---

<header class="cabecalho">
  <div class="container cabecalho-interno">
    <a class="wordmark" href={base}>Giuliano <em>Mendonça</em></a>

    <nav class="nav" aria-label="Principal">
      {
        NAVEGACAO.map((item) =>
          item.href ? (
            <a
              class="nav-item"
              href={`${base}${item.href}`}
              aria-current={caminho.startsWith(`${base}${item.href}`) ? 'page' : undefined}
            >
              {item.rotulo}
            </a>
          ) : (
            <span class="nav-item nav-item--inerte" aria-disabled="true">
              {item.rotulo}
            </span>
          ),
        )
      }

      <button id="alternar-tema" class="botao-tema" aria-label="Alternar tema" aria-pressed="false">
        <span class="rotulo-para-escuro">escuro</span>
        <span class="rotulo-para-claro">claro</span>
      </button>
    </nav>
  </div>
</header>

<script>
  /* O JavaScript de tema faz exatamente duas coisas: lê a preferência e troca
     data-theme no <html>. Nenhum valor de cor mora aqui — as cores do tema
     escuro vivem em src/styles/overrides.css, em um bloco só (SPEC §3.2).
     Há teste que varre .ts/.js/.astro atrás de hexadecimal (§7.2). */
  const raiz = document.documentElement;
  const botao = document.getElementById('alternar-tema');

  function sincronizar() {
    botao?.setAttribute('aria-pressed', String(raiz.dataset.theme === 'dark'));
  }

  botao?.addEventListener('click', () => {
    const estaEscuro = raiz.dataset.theme === 'dark';

    if (estaEscuro) {
      delete raiz.dataset.theme;
      localStorage.setItem('tema', 'light');
    } else {
      raiz.dataset.theme = 'dark';
      localStorage.setItem('tema', 'dark');
    }

    sincronizar();
  });

  sincronizar();
</script>

<style>
  .cabecalho {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--page) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: var(--border-width) solid var(--border);
  }

  .cabecalho-interno {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 74px;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    /* 44px de alvo de toque — §7.3.2. */
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: var(--fw-medium);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-tight);
    color: var(--text-strong);
    text-decoration: none;
    white-space: nowrap;
  }

  /* --brand daria 4.36 aqui e o wordmark tem 22px — abaixo dos 24px que a WCAG
     exige para valer como "texto grande" com peso normal. Ou seja: ainda é
     texto normal, e precisa de 4.5. Usa --text-link (5.65), pela mesma regra
     da correção 2 de overrides.css. Ver SPEC §3.4 — o limiar de 18px citado lá
     é menor que o da WCAG, e este é o caso que cai no vão. */
  .wordmark em {
    color: var(--text-link);
    font-style: italic;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .nav-item {
    display: inline-flex;
    align-items: center;
    /* 44px de alvo de toque — §7.3.2. Sem isto dá 43px, e falha por 1px. */
    min-height: 44px;
    font-size: var(--text-sm);
    font-weight: var(--fw-medium);
    color: var(--text-body);
    text-decoration: none;
    padding-block: var(--space-2);
    border-bottom: var(--border-width-strong) solid transparent;
    white-space: nowrap;
    transition: var(--transition-colors);
  }

  a.nav-item:hover {
    color: var(--text-link);
    text-decoration: none;
  }

  a.nav-item[aria-current='page'] {
    color: var(--text-link);
    border-bottom-color: var(--brand);
  }

  .nav-item--inerte {
    color: var(--text-subtle);
    cursor: default;
  }

  .botao-tema {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 44px de alvo de toque — §7.3.2 mede o botão de tema explicitamente. */
    min-height: 44px;
    min-width: 44px;
    padding: var(--space-2) var(--space-3);
    margin-left: var(--space-2);
    background: none;
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    cursor: pointer;
    transition: var(--transition-colors);
  }

  .botao-tema:hover {
    color: var(--text-link);
    border-color: var(--brand-border);
  }

  /* O rótulo troca por CSS, não por JavaScript. Assim ele já sai correto no
     primeiro paint, junto com o tema, sem piscar o texto errado. */
  .rotulo-para-claro {
    display: none;
  }

  :global(:root[data-theme='dark']) .rotulo-para-escuro {
    display: none;
  }

  :global(:root[data-theme='dark']) .rotulo-para-claro {
    display: inline;
  }

  @media (max-width: 860px) {
    .cabecalho-interno {
      flex-wrap: wrap;
      padding-block: var(--space-3);
      gap: var(--space-3);
    }

    .nav {
      gap: var(--space-4);
      width: 100%;
    }
  }
</style>
