---
/** Badge do design system, reimplementado em .astro (SPEC §2.3). */
interface Props {
  tom?: 'brand' | 'petrol';
}

const { tom = 'brand' } = Astro.props;
---

<span class:list={['badge', `badge--${tom}`]}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    border: var(--border-width) solid transparent;
    white-space: nowrap;
  }

  /* Texto pequeno em terracota usa --text-link, nunca --brand: §3.4. */
  .badge--brand {
    background: var(--brand-subtle);
    border-color: var(--brand-border);
    color: var(--text-link);
  }

  .badge--petrol {
    background: var(--secondary-subtle);
    border-color: var(--petrol-200);
    color: var(--petrol-500);
  }
</style>
