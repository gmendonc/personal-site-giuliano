---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
import ItemLista from '../components/ItemLista.astro';
import Badge from '../components/Badge.astro';
import { pecasPublicadas } from '../lib/biblioteca';
import { TIPOS } from '../content/tipos';
import { formatarData } from '../lib/datas';
import retrato from '../assets/retrato.png';

/**
 * As seções desta página são markup inline, não componentes — de propósito.
 *
 * Um <Hero> que recebe eyebrow, título, subtítulo, quatro parágrafos e um
 * retrato tem interface tão complexa quanto sua implementação, e há UM ponto
 * de chamada. Extrair seria classitis. A regra do projeto: extraia quando
 * aparecer o segundo ponto de chamada, não antes (SPEC §8).
 *
 * Comprimento não é motivo para dividir. Este arquivo passa de 400 linhas e
 * isso está previsto na SPEC.
 */
const pecas = await pecasPublicadas();

const destaques = pecas.slice(0, 3);
const listaDensa = pecas.slice(0, 5);

const comecePorAqui = [
  {
    n: '01',
    titulo: 'Quero organizar meu próprio conhecimento',
    desc: 'A série sobre PARA, GTD e Zettelkasten em três níveis — do arquivo básico ao sistema que sustenta decisão.',
    cta: 'Ver a série',
  },
  {
    n: '02',
    titulo: 'Lidero IA na minha organização',
    desc: 'Ensaios sobre governança, adoção e o que quebra na prática quando o piloto encontra a operação.',
    cta: 'Ver ensaios',
  },
  {
    n: '03',
    titulo: 'Quero saber o que você pensa, em 10 minutos',
    desc: 'O ensaio-manifesto: não existe estratégia de IA, existe estratégia de negócio.',
    cta: 'Ler o ensaio',
  },
];

const identidades = [
  {
    kicker: 'O praticante',
    titulo: 'Quem implanta',
    desc: 'Programa corporativo de IA em quatro frentes, time de 12 pessoas, milhares de usuários internos. O que escrevo passou por essa fricção antes.',
    pecaTipo: 'Caso em destaque',
    pecaTitulo: 'O comitê que destravou a adoção',
    pecaCta: 'Ler o caso',
  },
  {
    kicker: 'O autor',
    titulo: 'Quem escreve',
    desc: 'Ensaios, notas e padrões sobre IA, decisão e gestão do conhecimento — mais de mil notas em um sistema pessoal mantido há anos.',
    pecaTipo: 'Ensaio em destaque',
    pecaTitulo: 'Mil notas depois: o que o Obsidian me ensinou sobre decidir',
    pecaCta: 'Ler o ensaio',
  },
];

/* Conteúdo estático inline. Não existe collection de aparições nesta fatia:
   são três itens fixos, e uma collection aqui seria um módulo raso (SPEC §5.1). */
const aparicoes = [
  {
    meta: '2025 · Web Summit Rio',
    evento: 'Web Summit Rio',
    disse: '“Não existe estratégia de IA” apresentado a um público de fundadores: a tese e o desconforto que ela causa.',
  },
  {
    meta: '2025 · Web Summit Portugal',
    evento: 'Web Summit Portugal',
    disse: 'Do piloto à produção — o que muda quando o usuário interno é o principal risco do projeto.',
  },
  {
    meta: '2026 · Congresso SAI Brasil',
    evento: 'Congresso SAI Brasil',
    disse: 'Governança de IA sem burocratizar a inovação: o paralelo com checklist de voo.',
  },
];

const base = import.meta.env.BASE_URL;
---

<Base>
  {/* ============ BLOCO 1 — Hero: bio-como-hero ============ */}
  <section class="container hero">
    <div>
      <p class="hero-eyebrow">IA aplicada · governança · gestão do conhecimento</p>
      <h1 class="hero-titulo">Descomplicando a tecnologia</h1>
      {/* REVISÃO PENDENTE: este subtítulo é o elemento mais fraco do par e está
          em revisão com o cliente. Mantido do protótipo de propósito. */}
      <p class="hero-subtitulo">Inteligência artificial com resultado</p>

      <div class="hero-regua"></div>

      <div class="hero-bio">
        <p>
          Lidero um programa corporativo de Inteligência Artificial — governança, plataforma,
          aplicações e estratégia — com um time de 12 pessoas e alguns milhares de usuários
          internos do outro lado.
        </p>
        <p>
          Antes disso foram 25 anos em engenharia e transformação digital, com um mestrado no
          meio do caminho sobre reconhecimento de padrões — o que hoje se chamaria de IA, e
          naquela época se chamava só de pesquisa. Aprendi a diferença entre uma tecnologia que
          funciona na demonstração e uma que sobrevive ao contato com a organização.
        </p>
        <p>
          Não acredito em colocar tecnologia em pedestal. Qualquer IA, no fundo, é muito boa em
          uma única coisa: dizer o quanto duas coisas são parecidas. Entender isso é o que separa
          quem usa IA com critério de quem compra promessa.
        </p>
        <p>
          Escrevo aqui sobre o que fica quando o hype passa: o que a IA muda de verdade no
          trabalho de quem decide, e como organizar o próprio conhecimento para decidir melhor.
        </p>
      </div>
    </div>

    <div>
      {/* Retrato real, processado por astro:assets (SPEC §7.3.3): sai em WebP,
          leva width/height no HTML — a caixa em --aspect-ratio: 4/5 já reserva
          o espaço, e width/height evita CLS mesmo antes da caixa existir. */}
      <div class="hero-retrato">
        <Image
          src={retrato}
          alt="Retrato de Giuliano Mendonça"
          width={800}
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  {/* ============ BLOCO 2 — Newsletter inline ============ */}
  <section class="faixa-newsletter">
    <div class="container">
      <Newsletter variante="inline" />
    </div>
  </section>

  {/* ============ BLOCO 3 — Comece por aqui ============ */}
  <section class="container secao">
    <p class="eyebrow-secao">Comece por aqui</p>
    <h2 class="titulo-secao">Três caminhos, dependendo do que te trouxe aqui</h2>
    <p class="intro-secao">Um caminho canônico, separado do arquivo cronológico.</p>

    <div class="comece-grade">
      {
        comecePorAqui.map((item) => (
          <a class="comece-card" href={`${base}biblioteca`}>
            <span class="comece-numero">{item.n}</span>
            <span>
              <span class="comece-titulo">“{item.titulo}”</span>
              <span class="comece-desc">{item.desc}</span>
            </span>
            <span class="comece-cta">{item.cta} →</span>
          </a>
        ))
      }
    </div>
  </section>

  {/* ============ BLOCO 4 — Textos recentes ============ */}
  <section class="container secao">
    <p class="eyebrow-secao">Publicações</p>
    <h2 class="titulo-secao">Textos recentes</h2>
    <p class="intro-secao">
      Ideias sobre estratégia, adoção e governança de IA — escritas de dentro de quem está
      implantando, não de quem só observa.
    </p>

    <div class="destaques-grade">
      {
        destaques.map((peca) => (
          <a class="destaque-card" href={`${base}biblioteca/${peca.id}`}>
            <span class="destaque-capa placeholder">capa ilustrada própria · linha + aquarela</span>
            <span class="destaque-corpo">
              <span class="destaque-meta">
                <Badge>{TIPOS[peca.data.tipo].rotulo}</Badge>
                <span class="destaque-data">{formatarData(peca.data.data)}</span>
              </span>
              <span class="destaque-titulo">{peca.data.titulo}</span>
              <span class="destaque-resumo">{peca.data.resumo}</span>
              <span class="destaque-cta">Ler →</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  {/* ============ BLOCO 5 — Lista densa ============ */}
  <section class="container secao-lista">
    <h2 class="visualmente-oculto">Publicações recentes</h2>
    <ul class="lista-densa">
      {listaDensa.map((peca) => <ItemLista peca={peca} />)}
    </ul>
    <p class="lista-densa-rodape">
      <a class="link-mono" href={`${base}biblioteca`}>Ver toda a biblioteca →</a>
    </p>
  </section>

  {/* ============ BLOCO 6 — Identidades paralelas ============ */}
  <section class="container secao">
    <h2 class="visualmente-oculto">Identidades paralelas</h2>
    <div class="identidades-grade">
      {
        identidades.map((id) => (
          <div class="identidade">
            <p class="identidade-kicker">{id.kicker}</p>
            <h3 class="identidade-titulo">{id.titulo}</h3>
            <p class="identidade-desc">{id.desc}</p>
            <a class="identidade-card" href={`${base}biblioteca`}>
              <span class="identidade-card-kind">{id.pecaTipo}</span>
              <span class="identidade-card-titulo">{id.pecaTitulo}</span>
              <span class="identidade-card-cta">{id.pecaCta} →</span>
            </a>
          </div>
        ))
      }
    </div>
  </section>

  {/* ============ BLOCO 7 — Aparições ============ */}
  <section class="faixa-aparicoes">
    <div class="container">
      <p class="aparicoes-eyebrow">Aparições</p>
      <h2 class="aparicoes-titulo">Onde eu falei, e o que eu disse lá</h2>
      <p class="aparicoes-intro">
        Prova por artefato: cada aparição leva à ideia que eu levei ao palco, não ao logotipo do
        evento.
      </p>

      <div class="aparicoes-grade">
        {
          aparicoes.map((a) => (
            <div class="aparicao">
              <p class="aparicao-meta">{a.meta}</p>
              <p class="aparicao-evento">{a.evento}</p>
              <p class="aparicao-disse">{a.disse}</p>
            </div>
          ))
        }
      </div>

      {/* A página /aparicoes não existe nesta fatia, então o link fica inerte:
          link para 404 é pior que link inerte (SPEC §5). */}
      <p class="aparicoes-rodape">
        <span class="aparicoes-link-inerte" aria-disabled="true">Todas as aparições →</span>
      </p>
    </div>
  </section>
</Base>

<style>
  .secao {
    padding-top: var(--space-9);
  }

  .secao-lista {
    padding-top: var(--space-7);
  }

  /* ============ Hero ============ */

  .hero {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: var(--space-9);
    align-items: start;
    padding-top: var(--space-10);
    padding-bottom: var(--space-9);
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 var(--space-5);
  }

  .hero-titulo {
    font-size: clamp(2.75rem, 5.2vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin: 0;
  }

  .hero-subtitulo {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: clamp(1.3125rem, 2.2vw, 1.8125rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--text-muted);
    margin: var(--space-4) 0 0;
    max-width: 22ch;
  }

  .hero-regua {
    height: 1px;
    background: var(--border);
    margin: var(--space-7) 0 var(--space-6);
    max-width: 520px;
  }

  .hero-bio {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 62ch;
    font-size: var(--text-md);
    line-height: 1.62;
    color: var(--text-body);
  }

  .hero-bio p {
    margin: 0;
  }

  .hero-retrato {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: var(--border-width) solid var(--border);
  }

  /* A imagem de origem é 928×1120 (0,829), a caixa é 4:5 (0,8) — quase igual,
     mas não exata. object-fit: cover absorve a diferença sem distorcer. */
  .hero-retrato :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ============ Comece por aqui ============ */

  .comece-grade {
    display: grid;
    gap: var(--space-4);
  }

  .comece-card {
    display: grid;
    grid-template-columns: 56px 1fr 120px;
    gap: var(--space-5);
    align-items: center;
    background: var(--surface-card);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
    text-decoration: none;
    box-shadow: var(--shadow-xs);
    transition:
      transform var(--dur-base) var(--ease-standard),
      box-shadow var(--dur-base) var(--ease-standard);
  }

  .comece-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    text-decoration: none;
  }

  .comece-numero {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    /* Numeral pequeno em terracota: --text-link, não --brand (§3.4). */
    color: var(--text-link);
  }

  .comece-titulo {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--fw-medium);
    letter-spacing: -0.015em;
    color: var(--text-strong);
    line-height: 1.25;
  }

  .comece-desc {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--text-base);
    line-height: 1.55;
    color: var(--text-muted);
  }

  .comece-cta {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-link);
    text-align: right;
  }

  /* ============ Textos recentes ============ */

  .destaques-grade {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .destaque-card {
    display: flex;
    flex-direction: column;
    background: var(--surface-card);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    box-shadow: var(--shadow-xs);
    transition:
      transform var(--dur-base) var(--ease-standard),
      box-shadow var(--dur-base) var(--ease-standard);
  }

  .destaque-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    text-decoration: none;
  }

  .destaque-capa {
    aspect-ratio: 16 / 10;
    border: none;
    border-bottom: var(--border-width) solid var(--border);
  }

  .destaque-corpo {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    flex: 1;
  }

  .destaque-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .destaque-data {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-subtle);
  }

  .destaque-titulo {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--fw-medium);
    line-height: 1.22;
    letter-spacing: -0.015em;
    color: var(--text-strong);
  }

  .destaque-resumo {
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--text-muted);
  }

  .destaque-cta {
    margin-top: auto;
    padding-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-link);
  }

  /* ============ Lista densa ============ */

  .lista-densa-rodape {
    margin: var(--space-4) 0 0;
  }

  /* ============ Identidades ============ */

  .identidades-grade {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .identidade {
    border-top: var(--border-width-strong) solid var(--brand);
    padding-top: var(--space-5);
  }

  .identidade-kicker {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-link);
    margin: 0 0 var(--space-2);
  }

  .identidade-titulo {
    font-size: var(--text-xl);
    margin: 0 0 var(--space-2);
  }

  .identidade-desc {
    margin: 0 0 var(--space-5);
    font-size: var(--text-base);
    line-height: var(--lh-body);
    color: var(--text-muted);
    max-width: 52ch;
  }

  .identidade-card {
    display: block;
    background: var(--surface-card);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-standard);
  }

  .identidade-card:hover {
    border-color: var(--brand-border);
    text-decoration: none;
  }

  .identidade-card-kind {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-subtle);
    margin-bottom: var(--space-2);
  }

  .identidade-card-titulo {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: var(--fw-medium);
    line-height: 1.25;
    color: var(--text-strong);
  }

  .identidade-card-cta {
    display: block;
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-link);
  }

  /* ============ Aparições ============ */

  .faixa-aparicoes {
    margin-top: var(--space-10);
    background: var(--petrol-400);
    border-top: var(--border-width) solid var(--petrol-500);
    padding-block: var(--space-9);
  }

  /* FALHA CONHECIDA E DOCUMENTADA — --accent sobre --petrol-400 dá 4.35,
     abaixo do mínimo AA de 4.5 para texto pequeno. Corrigir exige um dourado
     mais claro (direção --gold-200), o que muda a aparência do design system:
     é decisão do Giuliano, não da implementação. Ver SPEC §3.4.
     O teste de contraste reporta esse par com o ratio real. Não silencie.
     (Os hexadecimais ficam fora daqui de propósito: §7.2 proíbe valor de cor
     em .astro, e comentário conta.) */
  .aparicoes-eyebrow,
  .aparicao-meta {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 var(--space-3);
  }

  .aparicoes-titulo {
    font-size: clamp(1.75rem, 3.2vw, 2.125rem);
    color: var(--ivory-50);
    margin: 0 0 var(--space-2);
  }

  .aparicoes-intro {
    margin: 0 0 var(--space-6);
    font-size: var(--text-md);
    line-height: var(--lh-body);
    color: color-mix(in srgb, var(--ivory-100) 88%, transparent);
    max-width: 64ch;
  }

  .aparicoes-grade {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: color-mix(in srgb, var(--ivory-100) 22%, transparent);
  }

  .aparicao {
    background: var(--petrol-400);
    padding: var(--space-5);
  }

  .aparicao-evento {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: var(--fw-medium);
    line-height: 1.25;
    color: var(--ivory-50);
    margin: 0 0 var(--space-2);
  }

  .aparicao-disse {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--lh-body);
    color: color-mix(in srgb, var(--ivory-100) 88%, transparent);
  }

  .aparicoes-rodape {
    margin: var(--space-6) 0 0;
  }

  .aparicoes-link-inerte {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ivory-100) 70%, transparent);
    cursor: default;
  }

  /* ============ Responsivo — tudo em uma coluna abaixo de 860px (§5.5) ====== */

  @media (max-width: 860px) {
    .hero,
    .comece-card,
    .destaques-grade,
    .identidades-grade,
    .aparicoes-grade {
      grid-template-columns: 1fr;
    }

    .hero {
      gap: var(--space-7);
      padding-top: var(--space-7);
    }

    .comece-card {
      gap: var(--space-2);
    }

    .comece-cta {
      text-align: left;
    }
  }
</style>
