---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página não encontrada" descricao="Esta página não existe.">
  <div class="container-estreito erro">
    <p class="eyebrow-secao">Erro 404</p>
    <h1 class="erro-titulo">Esta página não existe</h1>
    <p class="erro-texto">
      O endereço pode ter mudado, ou o link que te trouxe aqui estava errado. A biblioteca tem
      tudo o que está publicado.
    </p>
    <p><a class="link-mono" href="/biblioteca">Ver toda a biblioteca →</a></p>
  </div>
</Base>

<style>
  .erro {
    padding-top: var(--space-10);
    padding-bottom: var(--space-10);
  }

  .erro-titulo {
    font-size: clamp(2.25rem, 4vw, 3rem);
    letter-spacing: -0.025em;
    margin: 0 0 var(--space-4);
  }

  .erro-texto {
    margin: 0 0 var(--space-4);
    font-size: var(--text-md);
    line-height: var(--lh-relaxed);
    color: var(--text-muted);
    max-width: 60ch;
  }
</style>
